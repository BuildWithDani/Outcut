{
	"name": "outcut-ai",
	"productName": "Outcut AI",
	"description": "A free, open-source video editor and screen recorder with auto-zoom, cursor effects, backgrounds, annotations, and more — developed by BuildWithDani. Derived from Recordly.",
	"author": "BuildWithDani",
	"homepage": "https://github.com/BuildWithDani/Outcut",
	"repository": {
		"type": "git",
		"url": "https://github.com/BuildWithDani/Outcut.git"
	},
	"bugs": {
		"url": "https://github.com/BuildWithDani/Outcut/issues"
	},
	"private": true,
	"version": "1.4.0",
	"type": "module",
	"scripts": {
		"dev": "vite --config vite.config.ts",
		"icons:outcut": "node scripts/generate-outcut-icons.mjs",
		"postinstall": "node scripts/postinstall.mjs",
		"build": "npm run build:platform-native-helpers && tsc && vite build --config vite.config.ts && npm run normalize:electron-main-cjs && npm run smoke:electron-main-cjs && electron-builder",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"preview": "vite preview --config vite.config.ts",
		"rebuild:native": "node ./node_modules/@electron/rebuild/lib/cli.js --force --only uiohook-napi",
		"build:native-helpers": "node scripts/build-native-helpers.mjs",
		"build:whisper-runtime": "node scripts/build-whisper-runtime.mjs",
		"build:platform-native-helpers": "npm run build:whisper-runtime && npm run build:native-helpers && npm run build:windows-capture && npm run build:windows-gpu-export && npm run build:nvidia-cuda-compositor && npm run build:cursor-monitor",
		"build:windows-gpu-export": "node scripts/build-windows-gpu-export.mjs",
		"build:nvidia-cuda-compositor": "node scripts/build-nvidia-cuda-compositor.mjs",
		"build:windows-capture": "node scripts/build-windows-capture.mjs",
		"build:cursor-monitor": "node scripts/build-cursor-monitor.mjs",
		"build:mac": "npm run build:platform-native-helpers && tsc && vite build --config vite.config.ts && npm run normalize:electron-main-cjs && npm run smoke:electron-main-cjs && electron-builder --mac",
		"build:win": "npm run build:platform-native-helpers && tsc && vite build --config vite.config.ts && npm run normalize:electron-main-cjs && npm run smoke:electron-main-cjs && electron-builder --win",
		"build:linux": "npm run build:platform-native-helpers && tsc && vite build --config vite.config.ts && npm run normalize:electron-main-cjs && npm run smoke:electron-main-cjs && electron-builder --linux",
		"i18n:check": "node scripts/i18n-check.mjs",
		"benchmark:export-queues": "node scripts/benchmark-export-queues.mjs",
		"normalize:electron-main-cjs": "node scripts/normalize-electron-main-cjs.mjs",
		"smoke:electron-main-cjs": "node scripts/smoke-electron-main-cjs.mjs",
		"smoke:packaged-binaries": "node scripts/smoke-packaged-binaries.mjs",
		"verify:macos-distribution": "node scripts/verify-macos-distribution.mjs",
		"checksums:release": "node scripts/write-release-checksums.mjs",
		"release:create": "node scripts/create-release.mjs",
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"test:ui": "playwright test",
		"dev:ui": "vite --mode ui --host 127.0.0.1"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@react-aria/breadcrumbs": "^3.6.1",
		"@react-aria/button": "^3.15.1",
		"@react-aria/calendar": "^3.10.1",
		"@react-aria/checkbox": "^3.17.1",
		"@react-aria/combobox": "^3.16.1",
		"@react-aria/datepicker": "^3.17.1",
		"@react-aria/dialog": "^3.6.1",
		"@react-aria/disclosure": "^3.2.1",
		"@react-aria/focus": "^3.22.1",
		"@react-aria/form": "^3.2.1",
		"@react-aria/gridlist": "^3.15.1",
		"@react-aria/interactions": "^3.28.1",
		"@react-aria/label": "^3.8.1",
		"@react-aria/link": "^3.9.1",
		"@react-aria/listbox": "^3.16.1",
		"@react-aria/menu": "^3.22.1",
		"@react-aria/numberfield": "^3.13.1",
		"@react-aria/overlays": "^3.32.1",
		"@react-aria/progress": "^3.5.1",
		"@react-aria/radio": "^3.13.1",
		"@react-aria/select": "^3.18.1",
		"@react-aria/separator": "^3.5.1",
		"@react-aria/slider": "^3.9.1",
		"@react-aria/spinbutton": "^3.8.1",
		"@react-aria/ssr": "^3.10.1",
		"@react-aria/switch": "^3.8.1",
		"@react-aria/table": "^3.18.1",
		"@react-aria/tabs": "^3.12.1",
		"@react-aria/textfield": "^3.19.1",
		"@react-aria/toast": "^3.1.1",
		"@react-aria/toggle": "^3.13.1",
		"@react-aria/tooltip": "^3.10.1",
		"@react-aria/tree": "^3.2.1",
		"@react-aria/utils": "^3.34.1",
		"@react-aria/visually-hidden": "^3.9.1",
		"@react-stately/utils": "^3.12.1",
		"@react-types/shared": "^3.37.0",
		"@solar-icons/react": "^2.3.0",
		"@supabase/supabase-js": "^2.116.0",
		"capturekit": "^1.0.13",
		"electron-updater": "^6.8.3",
		"ffmpeg-static": "^5.3.0",
		"ffprobe-static": "^3.1.0",
		"uiohook-napi": "^1.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@dnd-kit/core": "^6.3.1",
		"@electron/rebuild": "^4.2.0",
		"@fix-webm-duration/fix": "^1.0.1",
		"@heroui/react": "^3.2.6",
		"@heroui/styles": "^3.2.6",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/gif.js": "^0.2.5",
		"@types/node": "^25.0.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^4.2.1",
		"clsx": "^2.1.1",
		"dnd-timeline": "^2.2.0",
		"electron": "^43.1.0",
		"electron-builder": "^26.7.0",
		"emoji-picker-react": "^4.16.1",
		"fast-check": "^4.5.2",
		"gif.js": "^0.2.0",
		"mediabunny": "^1.25.1",
		"motion": "^12.23.24",
		"mp4box": "^2.2.0",
		"pixi-filters": "^6.1.5",
		"pixi.js": "^8.14.0",
		"postcss": "^8.5.6",
		"react": "^19.3.0",
		"react-aria": "^3.53.1",
		"react-dom": "^19.3.0",
		"react-icons": "^5.5.0",
		"react-resizable-panels": "^3.0.6",
		"react-rnd": "^10.5.2",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"terser": "^5.44.1",
		"typescript": "^5.2.2",
		"vite": "^5.1.6",
		"vite-plugin-electron": "^0.28.6",
		"vite-plugin-electron-renderer": "^0.14.5",
		"vitest": "^3.2.7",
		"web-demuxer": "^4.0.0"
	},
	"main": "dist-electron/main.cjs"
}
